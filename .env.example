# Firebase Web App configuration (Firebase Console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Optional. Register a reCAPTCHA Enterprise app in Firebase App Check first.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Local development only: connect to `firebase emulators:start` instead of
# the real project. Never set in production.
# VITE_FIREBASE_EMULATORS=true

# Server-side settings are NOT set here. FIREBASE_SERVICE_ACCOUNT (required),
# BLOCKED_IPS and IP_HASH_SECRET are Cloudflare Pages secrets/variables read by
# the Pages Functions; see "Abuse protection" in README.md.

# Absolute public origin, no trailing slash. Used for canonical links,
# Open Graph images, and the sitemap. Search engines ignore relative ones.
VITE_SITE_URL=https://genxyzlab.org

# Permanent first-party download routes. The tracked release manifest already
# contains these values; these variables are optional local-build fallbacks.
VITE_APK_DOWNLOAD_URL=https://downloads.genxyzlab.org/latest.apk
VITE_APK_SIZE=~100 MB
VITE_WINDOWS_DOWNLOAD_URL=https://downloads.genxyzlab.org/latest-windows.zip
VITE_WINDOWS_SIZE=~120 MB

VITE_APP_VERSION=1.0.0
VITE_RELEASE_DATE=
