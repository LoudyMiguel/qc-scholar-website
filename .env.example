# Firebase Web App configuration (Firebase Console -> Project settings -> Your apps)
VITE_FIREBASE_API_KEY=replace-me
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=replace-me
VITE_FIREBASE_APP_ID=replace-me

# Optional. Register a reCAPTCHA Enterprise app in Firebase App Check first.
VITE_FIREBASE_APPCHECK_SITE_KEY=

# Absolute public origin, no trailing slash. Used for canonical links,
# Open Graph images, and the sitemap. Search engines ignore relative ones.
VITE_SITE_URL=https://genxyzlab.com

# Release downloads. Host these outside the Git repository (Cloudflare R2 or
# GitHub Releases). A URL left on downloads.example.com is shown in the UI as
# "not published yet" rather than handed out as a dead link.
VITE_APK_DOWNLOAD_URL=https://downloads.example.com/genxyz-lab-latest.apk
VITE_APK_SIZE=~100 MB
VITE_WINDOWS_DOWNLOAD_URL=https://downloads.example.com/genxyz-lab-latest-windows.zip
VITE_WINDOWS_SIZE=~120 MB

VITE_APP_VERSION=1.0.0
VITE_RELEASE_DATE=
